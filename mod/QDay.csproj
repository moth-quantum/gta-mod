<Project Sdk="Microsoft.NET.Sdk">

  <!-- Q-DAY, a ScriptHookVDotNet 3 script for GTA V Legacy.
       Builds on macOS/Linux/Windows with `dotnet build`; the DLL targets .NET Framework 4.8
       because that is what SHVDN 3 loads. Output: bin/QDay.dll -> copy to GTAV/scripts/. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QDay</AssemblyName>
    <RootNamespace>QDay</RootNamespace>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy System.Text.Json and its dependencies to bin so ILRepack.targets can merge them into QDay.dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies let net48 compile without a Windows install -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Merges the NuGet dependencies into QDay.dll after build, see ILRepack.targets -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" PrivateAssets="all" />
    <!-- Compile against these only: the game provides its own copies. -->
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="LemonUI.SHVDN3" Version="2.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <!-- The Q-Day title's Atlas Type grid font (QDayTitle.cs), embedded like the recorded results below. -->
    <EmbeddedResource Include="..\recorded\qday_title_gridfont.json" LogicalName="recorded.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offline mode answers from these real Atlas results, so they ship inside the DLL.
         Every qrng_qpu_64q_*.json is a Q-Day run in QDayLibrary; the 12q no-bytes file stays out. -->
    <EmbeddedResource Include="..\recorded\graph_fake_*.json;..\recorded\qrng_qpu_64q_*.json;..\recorded\lockdown_*.json;..\recorded\entanglement_lut.bin;lockdown_districts.json" LogicalName="recorded.%(Filename)%(Extension)" />
    <!-- Replacement textures for TextureSwap, read with TextureSwap.GetEmbeddedTexture. -->
    <EmbeddedResource Include="..\recorded\qday_textures_mild\*.dds" LogicalName="textures.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copy the merged DLL into the game after every build when GameDir is set, usually in the
       gitignored QDay.csproj.user (MSBuild imports it automatically):
         <Project><PropertyGroup><GameDir>C:\path\to\Grand Theft Auto V</GameDir></PropertyGroup></Project>
       SHVDN loads a shadow copy, so this works with the game running; press Insert to reload. -->
  <Target Name="DeployToGame" AfterTargets="ILRepackDependencies" Condition="'$(GameDir)' != ''">
    <Copy SourceFiles="$(OutputPath)$(TargetName).dll;$(OutputPath)$(TargetName).pdb"
          DestinationFolder="$(GameDir)\scripts" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetName).dll to $(GameDir)\scripts" />
  </Target>

</Project>
