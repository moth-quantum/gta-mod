<Project Sdk="Microsoft.NET.Sdk">

  <!-- Q-DAY, a ScriptHookVDotNet 3 script for GTA V Legacy.
       Builds on macOS/Linux/Windows with `dotnet build`; the DLL targets .NET Framework 4.8
       because that is what SHVDN 3 loads. Output: bin/QDay.dll -> copy to GTAV/scripts/. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QDay</AssemblyName>
    <RootNamespace>QDay</RootNamespace>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies let net48 compile without a Windows install -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />
    <PackageReference Include="LemonUI.SHVDN3" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
