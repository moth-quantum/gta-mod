<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the hack's rules without the game. Links mod/HackPuzzle.cs as a source file; it lives
       outside mod/ so the mod's SDK-style project doesn't glob these files into QDay.dll.
       Run with: dotnet test tests/HackPuzzle.Tests -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../mod/HackPuzzle.cs" Link="HackPuzzle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
